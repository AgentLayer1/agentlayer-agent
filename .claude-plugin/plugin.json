{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "agentlayer",
  "version": "1.2.1",
  "description": "An agent that remembers your work, in a folder you own. It captures every session, compiles what it learned into plain markdown, and loads it back before you type. Tasks, briefings, a dashboard, and packs for GitHub, databases, support desks, SEO and a browser. All data stays local.",
  "author": {
    "name": "AgentLayer",
    "url": "https://agentlayer.one"
  },
  "homepage": "https://agentlayer.one",
  "repository": "https://github.com/AgentLayer1/agentlayer-agent",
  "license": "Apache-2.0",
  "icon": "./assets/agentlayer-logo.png",
  "engines": {
    "claude-code": ">=2.1.314"
  },
  "keywords": [
    "personal-ai",
    "knowledge-base",
    "task-management",
    "agentic",
    "seo",
    "content",
    "playwright",
    "google-search-console"
  ],
  "hooks": "./hooks/claude.json",
  "types": "./mods/types/index.d.ts",
  "mcpServers": {
    "agent": {
      "command": "bun",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/src/server.ts"
      ],
      "env": {
        "AGENT_PLUGIN_DATA": "${CLAUDE_PLUGIN_DATA}",
        "PLAYWRIGHT_BROWSERS_PATH": "0"
      }
    }
  }
}
