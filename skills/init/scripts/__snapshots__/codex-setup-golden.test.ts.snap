,
  "rules": 
"# Generated by the agentlayer plugin from this home's Claude permissions.ask and permissions.deny; regenerated by init and upgrade.

# Your own rules belong in another file in this directory: Codex loads every .rules file here.

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "git push waits for the operator, as it does under Claude Code",
)

prefix_rule(
    pattern = ["gh"],
    decision = "forbidden",
    justification = "gh is denied in this home, as it is under Claude Code",
)
"
,
