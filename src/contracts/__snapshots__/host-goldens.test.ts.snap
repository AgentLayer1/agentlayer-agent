exports[`the shell guard, per host Claude Code: a home-tree write from outside the home 1`] = `
{
  "exit": 2,
  "stderr": 
"Blocked: this shell command would write "projects/x.md" outside the agent home <HOME> (the command's cwd is <SCRATCH>). Home trees (knowledge/, projects/, reports/) take the absolute path under <HOME>, or cd back to the home first.
"
,
  "stdout": "",
}
`;

exports[`the shell guard, per host Claude Code: a cd that carries over 1`] = `
{
  "exit": 2,
  "stderr": 
"Blocked: this command would leave the session's working directory at <SCRATCH>, outside the agent home <HOME>, and a cd carries over to every later command. Name the repo instead (git -C <repo>, absolute paths), or keep the cd in a subshell: ( cd <repo> && … ).
"
,
  "stdout": "",
}
`;

exports[`the shell guard, per host Claude Code: a history rewrite 1`] = `
{
  "exit": 2,
  "stderr": 
"Blocked: git commit --amend rewrites or hides history, and git here is forward-only (AGENTS.md, Workflow): fix a commit with a new commit on top, and merge without discarding the other side. The one exception, scrubbing a confidentiality leak from an unpushed commit, is the operator's to run with !.
"
,
  "stdout": "",
}
`;

